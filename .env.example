# Copy to .env — never commit real values
ORCH_DOCKER__PRIVATE__REGISTRY_URL=
PIPELINE_DOCKER_REGISTRY=
PIPELINE_DOCKER_PASSWORD=
# optional, only needed to clone private tool repositories
PIPELINE_REPO_TOKEN=

# Enable after configuring the release key and the pipeline's KMS/Vault workload identity.
PIPELINE_COSIGN_SIGN=false
PIPELINE_COSIGN_KEY=
# Public keys are mounted read-only; tools and the build pipeline can use different signers.
PIPELINE_IMAGE_TRUST_TOOLS_ENABLED=false
PIPELINE_IMAGE_TRUST_TOOLS_PUBLIC_KEY=/etc/fl-net/trust/tools.pub
PIPELINE_IMAGE_TRUST_PIPELINE_ENABLED=false
PIPELINE_IMAGE_TRUST_PIPELINE_PUBLIC_KEY=/etc/fl-net/trust/pipeline.pub
